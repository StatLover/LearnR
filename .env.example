# ---------------------------------------------------------------------------
# R Academy configuration. Copy to .env.local and fill in what you need.
# Everything is optional: without these the site still works (R runs in the
# browser); the AI tutor and account sync stay switched off with a notice.
# ---------------------------------------------------------------------------

# --- AI tutor (server-side only – never exposed to the browser) ---
ANTHROPIC_API_KEY=
# Model used by the tutor and the error explainer (default: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high (default: medium)
AI_EFFORT=medium
# Server-side refusal fallback: "default" (recommended) or "off"
AI_FALLBACKS=default
# Rate limits per client IP (in-memory; use a shared store when running several instances)
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_DAY=200

# --- Optional accounts / progress sync (Supabase) ---
# Create a Supabase project, run supabase/schema.sql, then set:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- R in the browser (webR) ---
# Where the webR runtime is served from (default: /webr/ – copied from node_modules on install)
NEXT_PUBLIC_WEBR_BASE_URL=/webr/
# R package repository for webR (default: https://repo.r-wasm.org/)
NEXT_PUBLIC_WEBR_REPO_URL=https://repo.r-wasm.org/
